# DataVision AI Configuration

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Power BI Integration (Optional)
# If you want to connect to Power BI, add these credentials:

# Power BI Service Principal Credentials
POWER_BI_TENANT_ID=your_tenant_id
POWER_BI_CLIENT_ID=your_client_id
POWER_BI_CLIENT_SECRET=your_client_secret

# Power BI Workspace and Dataset IDs
POWER_BI_WORKSPACE_ID=your_workspace_id
POWER_BI_DATASET_ID=your_dataset_id

# How to get these credentials:
# 1. Go to https://dev.powerbi.com/apps
# 2. Create a new application
# 3. Copy the Client ID and generate a secret
# 4. In Azure Portal, find your Tenant ID
# 5. In Power BI Service, get your Workspace ID (from URL when viewing workspace)
# 6. Create a dataset in Power BI and get its ID from the dataset settings
